<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Palette CampusTask -->
    <Color x:Key="Primary">#2563EB</Color>
    <Color x:Key="PrimaryDark">#1E40AF</Color>
    <Color x:Key="Background">#F8FAFC</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#64748B</Color>
    <Color x:Key="Border">#E2E8F0</Color>
    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Error">#DC2626</Color>
    <Color x:Key="Overdue">#DC2626</Color>

    <!-- Alias pour compatibilité MAUI -->
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="Secondary">#64748B</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

</ResourceDictionary>
