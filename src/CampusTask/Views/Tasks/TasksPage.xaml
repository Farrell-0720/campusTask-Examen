<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CampusTask.ViewModels"
             xmlns:models="clr-namespace:CampusTask.Models"
             x:Class="CampusTask.Views.Tasks.TasksPage"
             x:DataType="vm:TasksViewModel"
             BackgroundColor="{StaticResource Background}"
             Title="Mes tâches">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">

        <SearchBar Grid.Row="0"
                   Placeholder="Rechercher une tâche..."
                   Text="{Binding SearchQuery}" />

        <Picker Grid.Row="1"
                Title="Filtrer"
                ItemsSource="{Binding FilterOptions}"
                SelectedItem="{Binding SelectedFilter}" />

        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding RefreshCommand}">

            <CollectionView ItemsSource="{Binding Tasks}"
                            SelectionMode="None"
                            EmptyView="Aucune tâche trouvée.">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AcademicTask">
                        <Frame Style="{StaticResource CardFrame}" Margin="0,0,0,8" Padding="12">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TasksViewModel}}, Path=OpenTaskCommand}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Text="{Binding Subject}" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding DueDate, StringFormat='{0:dd/MM/yyyy}'}" FontSize="12" />
                                    <Label Text="{Binding Priority}" FontSize="12" TextColor="{StaticResource Primary}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
