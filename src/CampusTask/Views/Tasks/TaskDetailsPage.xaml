<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CampusTask.ViewModels"
             x:Class="CampusTask.Views.Tasks.TaskDetailsPage"
             x:DataType="vm:TaskDetailsViewModel"
             BackgroundColor="{StaticResource Background}"
             Title="Détail de la tâche">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12"
                             IsVisible="{Binding Task, Converter={StaticResource NullToBoolConverter}}">

            <Label Text="{Binding Task.Title}" Style="{StaticResource TitleLabel}" />
            <Label Text="{Binding Task.Subject}" Style="{StaticResource SecondaryLabel}" />

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Task.DueDate, StringFormat='Date limite : {0:dd MMMM yyyy}'}" />
                    <Label Text="{Binding StatusLabel, StringFormat='Statut : {0}'}" />
                    <Label Text="{Binding Task.Priority, StringFormat='Priorité : {0}'}" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="Description" FontAttributes="Bold" />
            <Label Text="{Binding Task.Description}" Style="{StaticResource SecondaryLabel}" />

            <Button Text="Marquer comme terminée"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding MarkCompletedCommand}"
                    IsVisible="{Binding Task.Status, Converter={StaticResource IsTodoConverter}}" />

            <Button Text="Réouvrir"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ReopenCommand}"
                    IsVisible="{Binding Task.Status, Converter={StaticResource IsCompletedConverter}}" />

            <Button Text="Supprimer"
                    Style="{StaticResource DangerButton}"
                    Command="{Binding DeleteCommand}"
                    Margin="0,16,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
